{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "pages/**/*.js",
    "pages/**/*.jsx",
    "components/**/*.js",
    "components/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
