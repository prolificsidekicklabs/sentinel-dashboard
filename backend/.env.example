# Optional server-side configuration only. Sentinel does not load this file automatically.
# Copy individual values into the backend process environment or a secret manager.

# OpenAI-compatible model router (OmniRoute, 9Router, or another compatible gateway)
SENTINEL_MODEL_BASE_URL=http://127.0.0.1:20128/v1
SENTINEL_MODEL_API_KEY=
# Use the exact model identifier accepted by the selected gateway.
SENTINEL_MODEL_NAME=auto
SENTINEL_MODEL_TIMEOUT_SECONDS=30
SENTINEL_MODEL_ALLOW_INSECURE_HTTP=false

# Alpaca read-only market data and Trading API account/position reads
SENTINEL_ALPACA_KEY_ID=
SENTINEL_ALPACA_SECRET_KEY=
SENTINEL_ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Defaults to paper; use https://api.alpaca.markets only for an intentional live-account read.
SENTINEL_ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
SENTINEL_ALPACA_STOCK_FEED=iex
SENTINEL_ALPACA_TIMEOUT_SECONDS=20
SENTINEL_ALPACA_MAX_PAGES=20
SENTINEL_ALPACA_MAX_BARS=20000
SENTINEL_ALPACA_ALLOW_LIVE_READS=false
