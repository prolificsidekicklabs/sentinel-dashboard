# Server-side only. The service does not load this file automatically.
# Local compatibility token; disabled whenever SENTINEL_ENV=production.
SENTINEL_ENV=development
SENTINEL_API_KEY=

# OIDC identity validation (all three values are required together).
# User tokens must contain this issuer, audience, exp/iat/sub claims, and required scopes.
SENTINEL_OIDC_ISSUER=
SENTINEL_OIDC_AUDIENCE=
SENTINEL_OIDC_JWKS_URL=
SENTINEL_OIDC_JWKS_CACHE_SECONDS=300
SENTINEL_OIDC_TIMEOUT_SECONDS=5

# Durable single-node SQLite store. Use a managed PostgreSQL/KMS deployment for multi-node production.
SENTINEL_DATABASE_PATH=./var/sentinel.sqlite3
# Generate a URL-safe base64-encoded 32-byte key; store it in a deployment secret manager.
# Key rotation requires an explicit credential re-encryption migration.
SENTINEL_VAULT_MASTER_KEY=

# Third-party code runs only in a digest-pinned container via rootless Docker + gVisor (runsc).
# Example format: sentinel-plugin-runtime@sha256:<64 lowercase hex characters>
SENTINEL_PLUGIN_SANDBOX_IMAGE=
SENTINEL_OCI_RUNTIME=docker
SENTINEL_OCI_PROFILE=runsc

# Paper-order submission stays disabled until a dedicated operator-controlled enablement.
# Live hosts are never supported by the execution adapter.
SENTINEL_PAPER_EXECUTION_ENABLED=false

# Development-only shared paper credentials. Production users store credentials through
# the OIDC-protected /api/v1/me/credentials/alpaca endpoint, encrypted at rest.
# Never use live-account keys here.
SENTINEL_ALPACA_KEY_ID=
SENTINEL_ALPACA_SECRET_KEY=
SENTINEL_ALPACA_DATA_BASE_URL=https://data.alpaca.markets
SENTINEL_ALPACA_STOCK_FEED=iex
SENTINEL_ALPACA_TIMEOUT_SECONDS=20
SENTINEL_ALPACA_MAX_PAGES=20
SENTINEL_ALPACA_MAX_BARS=20000

# Optional server-side model router configuration (not required for paper data)
SENTINEL_MODEL_BASE_URL=http://127.0.0.1:20128/v1
SENTINEL_MODEL_API_KEY=
SENTINEL_MODEL_NAME=auto
SENTINEL_MODEL_TIMEOUT_SECONDS=30
SENTINEL_MODEL_ALLOW_INSECURE_HTTP=false
